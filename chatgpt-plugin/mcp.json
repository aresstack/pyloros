{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "pyloros": {
      "type": "streamable-http",
      "url": "https://pyloros.aresstack.de/",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "angel",
              "tokenEndpointAuthMethod": "client_secret_basic"
            },
            "authorizationUrl": "https://pyloros.aresstack.de/oauth/authorize",
            "tokenUrl": "https://pyloros.aresstack.de/oauth/token",
            "baseScopes": ["pyloros"]
          }
        }
      }
    }
  }
}
